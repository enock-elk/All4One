{
  "description": "Golden spot-checks for SA bank statement extraction. Used by npm test in functions/.",
  "fixtures": [
    {
      "id": "capitec_1date",
      "sampleFile": "Capitec 1 Date.pdf",
      "detectText": "Capitec Bank Fee Summary Money Out Summary Digital Payments",
      "expectProfile": { "bankId": "capitec", "layoutId": "1date" },
      "amountCases": [
        { "raw": "-R1 700.00", "expect": -1700 },
        { "raw": "Digital -1 700.00", "expect": -1700 },
        { "raw": "R12 000.00", "expect": 12000 }
      ],
      "goldRows": [
        { "note": "salary-like credit should be positive", "amountSign": "positive" },
        { "note": "cellphone fee typically -15.5 style", "amountSign": "negative" }
      ]
    },
    {
      "id": "capitec_2date",
      "sampleFile": "Capitec 2 Date.pdf",
      "detectText": "Capitec PostingDate TransactionDate Money In(R) Money Out(R) Balance(R)",
      "expectProfile": { "bankId": "capitec", "layoutId": "2date" },
      "amountCases": [
        { "raw": "12 000.00", "expect": 12000 },
        { "raw": "-1 000.00", "expect": -1000 }
      ]
    },
    {
      "id": "standard_left",
      "sampleFile": "Standard Bank Left-column Date.pdf",
      "detectText": "Standard Bank Transaction details Payments Deposits Balance VOD PREPAID PRE-PAID PAYMENT TO",
      "expectProfile": { "bankId": "standard", "layoutId": "left_date" }
    },
    {
      "id": "standard_mid",
      "sampleFile": "Standard Bank Mid-column Date & 2 row descriptions.pdf",
      "detectText": "Standard Bank Service Fee Debits Credits Date Balance BALANCE BROUGHT FORWARD IMMEDIATE PAYMENT",
      "expectProfile": { "bankId": "standard", "layoutId": "mid_date" },
      "amountCases": [
        { "raw": "1,000.00-", "expect": -1000 }
      ]
    },
    {
      "id": "absa_3row",
      "sampleFile": "Absa Weird 3 row description old type.pdf",
